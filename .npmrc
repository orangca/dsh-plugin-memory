# 与 DSH 安装 bundle 时的行为保持一致：peer 由宿主提供，不由本仓库自动安装。
# 好处：`pnpm install` 不会把 @deepseek-ai/* 的**旧发布版**拉进来（它们的类型与运行版不一致，
# 见 src/shims.d.ts 的说明），避免误按错误类型编程。
auto-install-peers=false
strict-peer-dependencies=false

# 跑脚本前不再另起子进程做依赖状态校验：本仓库脚本（build/typecheck/test）不依赖它，
# 而实测在受限环境里那个子进程会偶发失败，导致 pnpm 自身报错、掩盖真正的脚本结果。
verify-deps-before-run=false
